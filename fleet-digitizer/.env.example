# Server
PORT=3847

# Flag extracted values below this percent for human review
CONFIDENCE_THRESHOLD=70

# Page-label OCR provider: tesseract (local, default) | azure (optional cloud)
OCR_PROVIDER=tesseract

# Optional Azure AI Document Intelligence (prebuilt-read)
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Optional override for master templates directory (defaults to ../Templates)
# TEMPLATES_DIR=C:\Users\thind\OneDrive\Desktop\HACKATHON\Templates

# --- Template schema AI (text LLM; does NOT read handwriting) ---
TEMPLATE_AI_ENABLED=true
TEMPLATE_AI_PROVIDER=ollama
TEMPLATE_AI_BASE_URL=http://127.0.0.1:11434
TEMPLATE_AI_MODEL=gemma4:e2b
# TEMPLATE_AI_API_KEY=
TEMPLATE_AI_TIMEOUT_MS=120000

# --- Handwriting / digit vision LLM (Ollama multimodal) ---
# batch (default) = banded FWD/AFT table crops → structured JSON (few calls)
# primary = per-cell vision first, Tesseract fallback
# hybrid = Tesseract first, vision for weak/empty inked cells
# off = Tesseract only
VISION_OCR_ENABLED=true
VISION_OCR_MODEL=gemma4:e2b
VISION_OCR_MODE=batch
VISION_OCR_TIMEOUT_MS=60000
VISION_BATCH_TIMEOUT_MS=180000
VISION_BATCH_ROWS=9
VISION_BATCH_CELL_FALLBACK=true
VISION_OCR_CONCURRENCY=2

# If Ollama CUDA crashes on Windows, set user env OLLAMA_NUM_GPU=0 (CPU mode)
# and run scripts\start-ollama-cpu.ps1 after reboot if the tray app fails to serve.
# SCHEMA_CACHE_DIR=C:\Users\thind\OneDrive\Desktop\HACKATHON\fleet-digitizer\data\schemas
